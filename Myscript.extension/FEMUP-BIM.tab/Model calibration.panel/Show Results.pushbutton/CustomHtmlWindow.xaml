<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfh="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:WindowsForms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="Risultati Calibrazione"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Risultati di Calibrazione e Mappa MAC"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sezione Tabella -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Risultati di Calibrazione"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <wfh:WindowsFormsHost HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <WindowsForms:WebBrowser x:Name="WebBrowserTable"/>
                </wfh:WindowsFormsHost>
            </StackPanel>

            <!-- Sezione MAC + Legenda -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <wfh:WindowsFormsHost HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="450">
                    <WindowsForms:WebBrowser x:Name="WebBrowserMAC"/>
                </wfh:WindowsFormsHost>
                <StackPanel Width="60" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Legenda" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <Border Width="30" Height="150" BorderBrush="Gray" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Red" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="0" Grid.Column="0" HorizontalAlignment="Left"/>
                        <TextBlock Text="1" Grid.Column="1" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>

</Window>
